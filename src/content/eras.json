      "knowledgePoints": [
        {
          "id": "kp-fire",
          "anchor": {
            "mesh": "fire"
          },
          "title": "火的驯化",
          "body": "学会用火让人类能吃熟食、御寒、驱兽，是早期最重要的能源突破。最早确证用火可追溯至约100万年前（南非 Wonderwerk 洞穴），刻意生火的新证据约41.5万年前。",
          "data": [
            {
              "label": "时间",
              "value": "约100万–40万年前（有争议）",
              "source": "Nature（Davis et al. 2025）http://www.natureasia.com/en/info/press-releases/detail/9185"
            }
          ]
        },
        {
          "id": "kp-cooked",
          "anchor": {
            "mesh": "roast"
          },
          "title": "火烤熟食",
          "body": "最早确证的火烤熟食约78万年前（以色列 Gesher Benot Ya'aqov 烤鱼齿釉质受热证据）；“生食→熟食”的起点整体仍有争议。",
          "data": [
            {
              "label": "时间",
              "value": "约78万年前（熟食）；约100万年前（受控用火）",
              "source": "Nature Ecology & Evolution（Zohar et al. 2022）https://www.nature.com/articles/s41559-022-01910-z"
            }
          ]
        },
        {
          "id": "kp-lifespan",
          "anchor": {
            "mesh": "cave"
          },
          "title": "人均寿命",
          "body": "采集狩猎时代出生时预期寿命约30–35岁，但被极高婴儿死亡率拉低；活到成年者众数死亡年龄约68–78岁，并非“人人只活到30岁”。",
          "data": [
            {
              "label": "出生时预期寿命",
              "value": "约30–35岁（含婴儿死亡率口径）",
              "source": "Gurven & Kaplan（2007）https://onlinelibrary.wiley.com/doi/10.1111/j.1728-4457.2007.00171.x"
            }
          ]
        }
      ],
